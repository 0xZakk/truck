# Large research assets — reproducible via scripts/fetch-manuals.sh, not committed.
manuals/factory-service-manual/
manuals/owners-manual/*.pdf
manuals/brochures/*.pdf

# 3D meshes: our own Blender-generated parts (scripts/blender/*.py) are small and
# load-bearing for the viewer, so they're committed (force-added past this rule).
# This rule still ignores any large *sourced/AI-generated* meshes dropped in later.
models/**/*.glb
models/**/*.gltf

# CAD pipeline (text-to-cad skill): cad/*.py sources are truth; STEP + hidden
# topology sidecars regenerate via scripts/cad_export.sh. Venv is local.
cad/*.step
cad/.*.step.glb
.venv-cad/

# OS / editor cruft
.DS_Store
*.swp
__pycache__/
*.pyc

# Owner reference photos (large, local only)
reference/photos/*
!reference/photos/README.txt

# Knowledge base: regenerable artifacts (re-create with the kb-toolkit tools).
# The kb/ markdown (sources, notes, maps) IS committed — it's the knowledge base.
# normalized source captures (re-fetch via tools/ingest.py):
kb/.raw/
# semantic index (regenerate via tools/semantic_links.py embed):
tools/data/embeddings.npz
